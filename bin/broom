#!/usr/bin/env python3
"""broom: format and lint what changed. On the Bash PATH while the plugin is enabled; `broom --help`."""

import io
import json
import os
import sys


def _option(name: str, default: str) -> str:
    return os.environ.get("CLAUDE_PLUGIN_OPTION_" + name.upper(), "").strip().lower() or default


def _repo_file() -> bool:
    """A .broom.json between here and the git root can switch these hooks on, so it rules out the early exit."""
    d = os.getcwd()
    while True:
        if os.path.exists(os.path.join(d, ".broom.json")):
            return True
        if os.path.exists(os.path.join(d, ".git")) or os.path.dirname(d) == d:
            return False
        d = os.path.dirname(d)


# The edit and stop hooks fire on every edit and every turn but are off by default: leave before loading
# anything, so an idle hook costs one interpreter start.
if sys.argv[1:2] == ["hook"] and not _repo_file():
    event = sys.argv[2:3]
    if event == ["edit"] and _option("format_on", "commit") != "edit" and _option("check_on", "commit") != "stop":
        sys.exit(0)
    if event == ["stop"] and _option("check_on", "commit") != "stop":
        sys.exit(0)

# The commit hook sees every Bash call: Claude Code's `if` patterns can't match commands like
# `T=~/repo; git -C $T commit`, so broom filters for itself, and anything without both words leaves here.
if sys.argv[1:3] == ["hook", "commit"]:
    _raw = sys.stdin.read()
    try:
        _command = str((json.loads(_raw).get("tool_input") or {}).get("command", ""))
    except (ValueError, AttributeError):
        _command = ""
    if "git" not in _command or "commit" not in _command:
        sys.exit(0)
    sys.stdin = io.StringIO(_raw)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from broom.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
