{
  "description": "broom: sweep each git commit; optionally format per edit and check at stop (see /config)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/broom",
            "args": ["hook", "commit"],
            "timeout": 300,
            "statusMessage": "broom: sweeping the commit"
          },
          {
            "type": "command",
            "if": "Bash(git -C *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/broom",
            "args": ["hook", "commit"],
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|mcp__.*serena.*__(replace_symbol_body|insert_after_symbol|insert_before_symbol|replace_content|create_text_file|rename_symbol|replace_in_files|safe_delete_symbol))$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/broom",
            "args": ["hook", "edit"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/broom",
            "args": ["hook", "stop"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
